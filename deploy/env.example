# Copy to .env on the cloud VM. Generate different random database passwords.
APP_DOMAIN=your-domain.example
MYSQL_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password

# Email verification needs a working SMTP sender.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-app-password
