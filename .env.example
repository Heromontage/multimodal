MYSQL_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
COOKIE_SECURE=false
PORT=3000

# Gmail sender. Use an app password, not your normal Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=
# URL recipients can open. Use HTTPS for a public deployment.
APP_BASE_URL=http://localhost:3000
